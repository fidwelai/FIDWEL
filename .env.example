# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_NAME=FIDWEL

# Absolute base URL of the deployed site. Used to build links inside
# notification emails (e.g. https://fidwel.com). Optional — when unset, emails
# are sent without action buttons.
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase secret key. Bypasses Row Level Security and is used by
# route handlers to create orders and confirm payments. Never expose this.
SUPABASE_SECRET_KEY=

# Paystack. Add these to enable online checkout payments.
# Public key is used by the browser popup, secret key by server routes and the webhook.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Transactional email (Resend). Optional: when RESEND_API_KEY is empty every
# email is skipped and in-app notifications still work. NOTIFICATION_EMAIL_FROM
# is the verified sender, e.g. "FIDWEL <no-reply@fidwel.com>".
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Shared secret for scheduled tasks (cron) that call internal endpoints.
CRON_SECRET=

# Staff access. Comma-separated email lists. A signed-in account matching one of
# these is auto-promoted to profiles.role = 'agent' (or 'admin') on first use.
ADMIN_EMAILS=
AGENT_EMAILS=
